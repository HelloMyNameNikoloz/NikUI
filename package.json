{
  "name": "nikui",
  "displayName": "NikUI",
  "description": "Multi-instance Claude Code client for VS Code with a styled webview and a status sidebar.",
  "version": "0.2.0",
  "publisher": "nikoloz",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nikui",
          "title": "NikUI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "nikui": [
        {
          "id": "nikui.sessions",
          "name": "Instances",
          "visibility": "visible"
        },
        {
          "id": "nikui.history",
          "name": "History",
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "nikui.sessions",
        "contents": "No instances yet.\n\nAn instance is one Claude Code process, running in one folder, with its own editor tab. You can run several at once.\n\n[Start an instance](command:nikui.newSession)\n\nIt asks which folder to run in. Past conversations are under History below, and can be reopened from there."
      },
      {
        "view": "nikui.history",
        "contents": "No past conversations in this workspace yet.\n\nEvery instance you run is written to a transcript and shows up here, so you can reopen it later.\n\n[Look in every folder](command:nikui.historyScope)",
        "when": "nikui.historyScope == 'workspace'"
      },
      {
        "view": "nikui.history",
        "contents": "No past conversations on this machine yet.\n\nEvery instance you run is written to a transcript and shows up here.\n\n[Back to this workspace](command:nikui.historyScope)",
        "when": "nikui.historyScope == 'all'"
      }
    ],
    "commands": [
      {
        "command": "nikui.newSession",
        "title": "NikUI: New Instance",
        "icon": "$(add)"
      },
      {
        "command": "nikui.newSessionHere",
        "title": "NikUI: New Instance in Folder..."
      },
      {
        "command": "nikui.newSessionInFolder",
        "title": "NikUI: New Instance in This Folder",
        "icon": "$(add)"
      },
      {
        "command": "nikui.nextInstance",
        "title": "NikUI: Next Instance"
      },
      {
        "command": "nikui.previousInstance",
        "title": "NikUI: Previous Instance"
      },
      {
        "command": "nikui.open",
        "title": "NikUI: Open Instance"
      },
      {
        "command": "nikui.interrupt",
        "title": "NikUI: Interrupt",
        "icon": "$(debug-pause)"
      },
      {
        "command": "nikui.restart",
        "title": "NikUI: Restart Instance",
        "icon": "$(debug-restart)"
      },
      {
        "command": "nikui.status",
        "title": "NikUI: Instance Status",
        "icon": "$(pulse)"
      },
      {
        "command": "nikui.sleep",
        "title": "NikUI: Stop Process (keep the instance)",
        "icon": "$(debug-stop)"
      },
      {
        "command": "nikui.stop",
        "title": "NikUI: Close Instance (conversation stays in History)",
        "icon": "$(close)"
      },
      {
        "command": "nikui.rename",
        "title": "NikUI: Rename Instance",
        "icon": "$(edit)"
      },
      {
        "command": "nikui.clearStopped",
        "title": "NikUI: Remove Instances Whose Process Has Exited",
        "icon": "$(clear-all)"
      },
      {
        "command": "nikui.refresh",
        "title": "NikUI: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "nikui.refreshHistory",
        "title": "NikUI: Refresh History",
        "icon": "$(refresh)"
      },
      {
        "command": "nikui.historyScope",
        "title": "NikUI: History — This Workspace or Everywhere",
        "icon": "$(globe)"
      },
      {
        "command": "nikui.historyFilter",
        "title": "NikUI: Filter History...",
        "icon": "$(search)"
      },
      {
        "command": "nikui.historyMore",
        "title": "NikUI: Show More History"
      },
      {
        "command": "nikui.deleteHistory",
        "title": "NikUI: Delete Transcript...",
        "icon": "$(trash)"
      },
      {
        "command": "nikui.resumeHistory",
        "title": "NikUI: Resume Conversation"
      },
      {
        "command": "nikui.showHistory",
        "title": "NikUI: Show History",
        "icon": "$(history)"
      },
      {
        "command": "nikui.newFolder",
        "title": "NikUI: New Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "nikui.renameFolder",
        "title": "NikUI: Rename Folder",
        "icon": "$(edit)"
      },
      {
        "command": "nikui.deleteFolder",
        "title": "NikUI: Delete Folder",
        "icon": "$(trash)"
      },
      {
        "command": "nikui.moveToFolder",
        "title": "NikUI: Move to Folder...",
        "icon": "$(folder)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nikui.newSession",
          "when": "view == nikui.sessions",
          "group": "navigation@1"
        },
        {
          "command": "nikui.clearStopped",
          "when": "view == nikui.sessions",
          "group": "navigation@9"
        },
        {
          "command": "nikui.historyFilter",
          "when": "view == nikui.history",
          "group": "navigation@1"
        },
        {
          "command": "nikui.historyScope",
          "when": "view == nikui.history",
          "group": "navigation@2"
        },
        {
          "command": "nikui.refreshHistory",
          "when": "view == nikui.history",
          "group": "navigation@3"
        },
        {
          "command": "nikui.newFolder",
          "when": "view == nikui.sessions",
          "group": "navigation@2"
        },
        {
          "command": "nikui.showHistory",
          "when": "view == nikui.sessions",
          "group": "navigation@3"
        },
        {
          "command": "nikui.newSessionHere",
          "when": "view == nikui.sessions",
          "group": "1_new@1"
        }
      ],
      "view/item/context": [
        {
          "command": "nikui.interrupt",
          "when": "view == nikui.sessions && viewItem == running",
          "group": "inline@1"
        },
        {
          "command": "nikui.rename",
          "when": "view == nikui.sessions && (viewItem == running || viewItem == idle)",
          "group": "inline@2"
        },
        {
          "command": "nikui.restart",
          "when": "view == nikui.sessions && (viewItem == running || viewItem == idle)",
          "group": "1_run@1"
        },
        {
          "command": "nikui.status",
          "when": "view == nikui.sessions && (viewItem == running || viewItem == idle)",
          "group": "1_run@2"
        },
        {
          "command": "nikui.sleep",
          "when": "view == nikui.sessions && (viewItem == running || viewItem == idle)",
          "group": "1_run@3"
        },
        {
          "command": "nikui.stop",
          "when": "view == nikui.sessions && (viewItem == running || viewItem == idle)",
          "group": "inline@3"
        },
        {
          "command": "nikui.moveToFolder",
          "when": "view == nikui.sessions && (viewItem == running || viewItem == idle)",
          "group": "2_organise@1"
        },
        {
          "command": "nikui.newSessionInFolder",
          "when": "view == nikui.sessions && viewItem == nikuiFolder",
          "group": "inline@0"
        },
        {
          "command": "nikui.deleteHistory",
          "when": "view == nikui.history && viewItem == historyEntry",
          "group": "9_danger@1"
        },
        {
          "command": "nikui.renameFolder",
          "when": "view == nikui.sessions && viewItem == nikuiFolder",
          "group": "inline@1"
        },
        {
          "command": "nikui.deleteFolder",
          "when": "view == nikui.sessions && viewItem == nikuiFolder",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "nikui.open",
          "when": "false"
        },
        {
          "command": "nikui.rename",
          "when": "false"
        },
        {
          "command": "nikui.restart",
          "when": "false"
        },
        {
          "command": "nikui.stop",
          "when": "false"
        },
        {
          "command": "nikui.interrupt",
          "when": "false"
        },
        {
          "command": "nikui.sleep",
          "when": "false"
        },
        {
          "command": "nikui.resumeHistory",
          "when": "false"
        },
        {
          "command": "nikui.newSessionInFolder",
          "when": "false"
        },
        {
          "command": "nikui.deleteHistory",
          "when": "false"
        },
        {
          "command": "nikui.historyMore",
          "when": "false"
        },
        {
          "command": "nikui.renameFolder",
          "when": "false"
        },
        {
          "command": "nikui.deleteFolder",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "nikui.newSession",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "nikui.showHistory",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h"
      },
      {
        "command": "nikui.nextInstance",
        "key": "ctrl+alt+]",
        "mac": "cmd+alt+]"
      },
      {
        "command": "nikui.previousInstance",
        "key": "ctrl+alt+[",
        "mac": "cmd+alt+["
      },
      {
        "command": "nikui.status",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "activeWebviewPanelId == 'nikui.session'"
      }
    ],
    "configuration": {
      "title": "NikUI",
      "properties": {
        "nikui.claudePath": {
          "type": "string",
          "default": "claude",
          "description": "Path to the claude executable."
        },
        "nikui.model": {
          "type": "string",
          "default": "",
          "description": "Model to pass to --model. Empty uses your Claude Code default."
        },
        "nikui.permissionMode": {
          "type": "string",
          "enum": [
            "bypassPermissions",
            "acceptEdits",
            "plan",
            "default"
          ],
          "default": "bypassPermissions",
          "description": "Value passed to --permission-mode. Defaults to bypassPermissions."
        },
        "nikui.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra CLI arguments appended to every instance."
        },
        "nikui.autoTitleFromTicket": {
          "type": "boolean",
          "default": true,
          "description": "Name instances from a PR/issue number found in your prompts."
        },
        "nikui.fontFamily": {
          "type": "string",
          "default": "",
          "description": "Font for the conversation. Empty uses the VS Code UI font."
        },
        "nikui.fontSize": {
          "type": "number",
          "default": 13,
          "description": "Conversation font size in px."
        },
        "nikui.notifyOnAttention": {
          "type": "boolean",
          "default": true,
          "description": "Tell you when an instance you cannot see is waiting for an answer, or could not start at all."
        },
        "nikui.interruptOnSingleEscape": {
          "type": "boolean",
          "default": false,
          "description": "Interrupt the running turn on the first Escape, the way the CLI does. Off by default: Escape is the key people press to dismiss things, so NikUI asks for a second press within two seconds before abandoning a turn."
        },
        "nikui.maxTranscriptItems": {
          "type": "number",
          "default": 400,
          "minimum": 0,
          "description": "How many messages, tool calls and results an instance keeps in memory. Older ones are dropped from the panel — the full record stays in the transcript on disk. 0 keeps everything, at the cost of memory on very long conversations."
        },
        "nikui.keepHiddenPanelsWarm": {
          "type": "boolean",
          "default": false,
          "description": "Keep the webview of a hidden instance in memory so switching back is instant. Off by default: with several instances open it costs real memory, and a hidden panel is rebuilt from the instance the moment you return to it."
        },
        "nikui.showThinking": {
          "type": "boolean",
          "default": true,
          "description": "Show thinking blocks (collapsed)."
        },
        "nikui.statusEmoji": {
          "type": "object",
          "default": {
            "idle": "⚪",
            "working": "🟠",
            "waiting": "🔴",
            "done": "🟢",
            "error": "🔴",
            "stopped": "⚫"
          },
          "description": "Emoji used per status in panel titles."
        },
        "nikui.effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            ""
          ],
          "default": "max",
          "description": "Reasoning effort passed to --effort. Empty inherits your Claude Code default."
        },
        "nikui.outputStyle": {
          "type": "string",
          "default": "Concise",
          "description": "Output style for every instance. Empty inherits your Claude Code default."
        },
        "nikui.groupByProject": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto",
          "description": "Group instances by project folder in the sidebar. \"auto\" nests them only once more than one project is open."
        }
      }
    }
  },
  "scripts": {
    "test": "node test/run.js",
    "test:live": "node test/live.check.js",
    "test:webview": "node test/webview.check.js"
  }
}

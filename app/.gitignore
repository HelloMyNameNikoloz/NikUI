# Generated by tools/build.js from media/ — never edited, never committed.
www/

node_modules/

# Native build output. The projects themselves are committed: they carry the
# icons, the manifest and the signing setup, and regenerating them by hand is
# how an app quietly loses a permission somebody added six months ago.
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/.idea/
ios/App/Pods/
ios/App/build/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
DerivedData/
*.xcuserstate
keystore.properties
*.jks
*.keystore
app/screens/

# Pictures of the real app on a real phone, taken by app/tools/screens.js.
# Useful to look at, not worth keeping: take them again.
screens/

# Builds to install by hand. Made from the repo, never part of it.
dist/

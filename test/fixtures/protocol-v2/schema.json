    "wire-welcome": {
      "type": "object",
      "required": [
        "type",
        "proto",
        "caps",
        "engine",
        "seat",
        "receipts"
      ],
      "properties": {
        "type": {
          "const": "welcome"
        },
        "proto": {
          "enum": [
            1,
            2
          ]
        },
        "caps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[\\u0000-\\u007f]+$"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        },
        "engine": {
          "type": "object",
          "required": [
            "id",
            "boot",
            "version",
            "mode"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "boot": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "version": {
              "type": "string",
              "maxLength": 80
            },
            "mode": {
              "enum": [
                "window",
                "service"
              ]
            }
          },
          "additionalProperties": false
        },
        "seat": {
          "$ref": "#/$defs/seat"
        },
        "receipts": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "scope",
                "retentionMs",
                "maxEntries",
                "maxBytes",
                "maxMessageBytes",
                "maxResultBytes",
                "now"
              ],
              "properties": {
                "scope": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "retentionMs": {
                  "const": 86400000
                },
                "maxEntries": {
                  "const": 10000
                },
                "maxBytes": {
                  "const": 134217728
                },
                "maxMessageBytes": {
                  "const": 16777216
                },
                "maxResultBytes": {
                  "const": 16777216
                },
                "now": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
